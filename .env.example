# =============================================================================
#  Thai Audio Recording Project — ตัวอย่างตัวแปรสภาพแวดล้อม (.env.example)
# -----------------------------------------------------------------------------
#  เว็บไซต์นี้เป็น "static site" (ไม่มีเซิร์ฟเวอร์) ค่าหลักตั้งได้ที่ assets/js/config.js
#  ไฟล์นี้ใช้เมื่อคุณเชื่อมฟอร์มเข้ากับบริการภายนอก (เช่น serverless / webhook)
#  ⚠️ ห้าม commit ไฟล์ .env จริงขึ้น repository  (ดู .gitignore)
# =============================================================================

# ปลายทางรับข้อมูลฟอร์ม (นำค่าไปใส่ที่ registration.endpoint ใน config.js
# หรือใช้ผ่าน serverless function ที่คุณสร้างเอง)
REGISTRATION_ENDPOINT=

# ตัวอย่างคีย์บริการฐานข้อมูล/ฟอร์ม (เก็บฝั่งเซิร์ฟเวอร์เท่านั้น — ห้ามใส่ในโค้ดฝั่งหน้าเว็บ)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
GOOGLE_SHEETS_WEBHOOK_URL=

# Analytics (ปกติตั้งใน config.js — วางไว้ที่นี่เผื่อ build pipeline อ่านค่า)
GA4_ID=
GTM_ID=
GOOGLE_ADS_CONVERSION_ID=
GOOGLE_ADS_CONVERSION_LABEL=
